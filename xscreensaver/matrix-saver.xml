<?xml version="1.0" encoding="ISO-8859-1"?>

<screensaver name="matrix-saver" _label="Matrix (cmatrix)">

  <hgroup>
    <vgroup>
      <number id="speed" type="slider" arg="-speed %"
              _label="Speed" _low-label="Fast" _high-label="Slow"
              low="0" high="10" default="6"/>

      <number id="fontsize" type="spinbutton" arg="-font-size %"
              _label="Font size" low="6" high="48" default="11"/>
    </vgroup>
    <vgroup>
      <select id="charset">
        <option id="japanese" _label="Katakana (needs a CJK font)"/>
        <option id="ascii" _label="ASCII" arg-set="-ascii"/>
      </select>

      <select id="bold">
        <option id="some" _label="Some bold glyphs"/>
        <option id="all" _label="All bold" arg-set="-bold all"/>
        <option id="none" _label="No bold" arg-set="-bold no"/>
      </select>
    </vgroup>
  </hgroup>

  <_description>
The digital rain from The Matrix, drawn by cmatrix inside an embedded
xterm. Colours and font can be changed in ~/.config/matrix-saver/config.

https://github.com/abishekvashok/cmatrix
  </_description>
</screensaver>
